[Icon Theme]
Name=LanicOS
Name[en_GB]=Cyan-Breeze-Dark-Icons

Comment=Cyan-Breeze-Dark-Icons
Comment[en_GB]=Cyan-Breeze-Dark-Icons

DisplayDepth=32

Inherits=hicolor

Example=folder

FollowsColorScheme=true

DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

KDE-Extensions=.svg

########## Directories
# GTK-tuned: places/* is listed FIRST so that on equal size distance GTK
# prefers the colored folder icons over monochrome actions/* ones.

Directories=places/16,places/22,places/24,places/32,places/64,actions/12,actions/16,actions/22,actions/24,actions/32,actions/48,actions/64,animations/16,animations/22,apps/16,apps/scalable,categories/22,categories/24,categories/32,devices/16,devices/22,devices/24,devices/32,devices/64,emblems/8,emblems/16,emblems/22,emblems/24,emotes/22,mimetypes/scalable,status/16,status/22,status/24,status/32,status/48,status/64
ScaledDirectories=places/16@2x,places/16@3x,places/22@2x,places/22@3x,places/24@2x,places/24@3x,actions/16@2x,actions/16@3x,actions/22@2x,actions/22@3x,actions/24@2x,actions/24@3x,actions/32@2x,actions/32@3x,categories/24@2x,categories/24@3x,devices/16@2x,devices/16@3x,devices/22@2x,devices/22@3x,devices/24@2x,devices/24@3x,emblems/24@2x,emblems/24@3x,status/16@2x,status/16@3x,status/22@2x,status/22@3x,status/24@2x,status/24@3x

